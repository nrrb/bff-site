---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Big Friendly Function — Nicholas, Freelance Developer & Designer',
  description = 'Web apps, desktop apps, custom code, design, and AI tooling — built by one big friendly function.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#16151A" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://bigfriendlyfunction.com" />

    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
